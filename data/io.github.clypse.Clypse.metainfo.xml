<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.clypse.Clypse</id>
  <name>Clypse</name>
  <summary>Modern clipboard manager for Linux</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.clypse">
    <name>Clypse Team</name>
  </developer>
  <description>
    <p>
      Clypse is a fast, native clipboard manager for Linux desktops.
      Built with Rust and GTK4/libadwaita, it integrates natively with
      COSMIC OS, GNOME, and any Wayland compositor.
    </p>
    <ul>
      <li>Persistent clipboard history across reboots</li>
      <li>Instant full-text search via FTS5</li>
      <li>Favorites and pinned items</li>
      <li>Image support with thumbnails</li>
      <li>Event-driven Wayland clipboard monitoring (no polling)</li>
      <li>Clipboard persistence: content survives app closure</li>
      <li>Follows system dark/light theme automatically</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/clypse/clypse</url>
  <url type="bugtracker">https://github.com/clypse/clypse/issues</url>
  <launchable type="desktop-id">io.github.clypse.Clypse.desktop</launchable>
  <provides>
    <binary>clypse</binary>
    <binary>clypse-daemon</binary>
  </provides>
  <releases>
    <release version="0.1.0" date="2026-05-15">
      <description><p>Initial release. Complete architectural rewrite in Rust.</p></description>
    </release>
  </releases>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <recommends>
    <display_length compare="ge">360</display_length>
  </recommends>
</component>
