<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.felipe_abreu.Clypse</id>
  <name>Clypse</name>
  <summary>Modern clipboard manager for Linux</summary>
  <metadata_license>FSFAP</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.felipe_abreu">
    <name>Felipe Abreu</name>
  </developer>
  <description>
    <p>
      Clypse is a fast, native clipboard manager for Linux desktops.
      Built with Rust and GTK4/libadwaita, it integrates natively with
      COSMIC OS, GNOME, and any Wayland compositor — including a COSMIC
      panel applet for quick access to your clipboard history.
    </p>
    <ul>
      <li>Persistent clipboard history across reboots</li>
      <li>Instant full-text search via FTS5</li>
      <li>Favorites and pinned items</li>
      <li>Image support with thumbnails</li>
      <li>Event-driven Wayland clipboard monitoring (no polling)</li>
      <li>Clipboard persistence: content survives app closure</li>
      <li>COSMIC panel applet with quick history popup</li>
      <li>Follows system dark/light theme automatically</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/Felipe-Abreu/Clypse</url>
  <url type="bugtracker">https://github.com/Felipe-Abreu/Clypse/issues</url>
  <url type="vcs-browser">https://github.com/Felipe-Abreu/Clypse</url>
  <launchable type="desktop-id">io.github.felipe_abreu.Clypse.desktop</launchable>
  <provides>
    <binary>clypse</binary>
    <binary>clypse-daemon</binary>
    <binary>clypse-applet</binary>
  </provides>
