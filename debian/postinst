#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Recarrega o daemon systemd do usuário e habilita o serviço
    # SUDO_USER está definido quando executado via sudo; logname retorna o usuário de login
    REAL_USER="${SUDO_USER:-$(logname 2>/dev/null || true)}"

    if [ -n "$REAL_USER" ] && id "$REAL_USER" >/dev/null 2>&1; then
        REAL_UID=$(id -u "$REAL_USER")
        XDG_RUNTIME="/run/user/${REAL_UID}"
        DBUS_ADDR="unix:path=${XDG_RUNTIME}/bus"

        # daemon-reload + enable + start (falha silenciosamente se sessão não ativa)
        runuser -u "$REAL_USER" -- \
            env XDG_RUNTIME_DIR="$XDG_RUNTIME" \
                DBUS_SESSION_BUS_ADDRESS="$DBUS_ADDR" \
            systemctl --user daemon-reload 2>/dev/null || true

        runuser -u "$REAL_USER" -- \
            env XDG_RUNTIME_DIR="$XDG_RUNTIME" \
                DBUS_SESSION_BUS_ADDRESS="$DBUS_ADDR" \
            systemctl --user enable --now clypse-daemon.service 2>/dev/null || true
    fi
fi

#DEBHELPER#
